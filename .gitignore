# ================================
# Fakt Project .gitignore
# ================================

# ================================
# Build Directories
# ================================
**/build/
.gradle/
.kotlin/

# ================================
# IDE Files
# ================================
**/.idea/*
!.idea/externalDependencies.xml
!.idea/ktfmt.xml
!.idea/kotlinTestDataPluginTestDataPaths.xml
.iml
.project
.classpath
*.iml
out/

# ================================
# macOS
# ================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ================================
# Local Configuration
# ================================
local.properties
gradle.properties.local
secrets.properties

# ================================
# Generated Code (Fakt Plugin)
# ================================
**/generated/fakt/**
**/fakt-report.json
**/fakt-signatures.cache

# ================================
# Build Artifacts
# ================================
**/build/classes/**
**/build/libs/**
**/build/tmp/**
**/build/kotlin/**
**/build/generated/**
*.class

# Keep gradle wrapper
!gradle/wrapper/*.jar
!gradle/wrapper/*.properties

# ================================
# Node.js / JavaScript (KMP)
# ================================
**/node_modules/**
**/build/js/**
package-lock.json
yarn.lock

# ...but DO version-control the committed Kotlin/JS + Wasm lock files under
# kotlin-js-store/. Committing them makes kotlin*RestoreYarnLock RUN (instead of
# SKIP), which deterministically materializes build/**/yarn.lock BEFORE
# kotlin*StoreYarnLock snapshots it. Without this, Store races NpmInstall and
# fails under Gradle 9.5+ (missing-input validation is now a hard error).
!**/kotlin-js-store/**/yarn.lock

# ================================
# Temporary Files
# ================================
**/*.tmp
.gradle/**/classloaderscopes*.tmp
*.swp
*.swo
*~
*.log

# ================================
# Documentation (Generated/Temp)
# ================================
gradle-plugin/docs/
docs/code-of-conduct.md
docs/contributing.md
docs/changelog.md
docs/samples.md
docs/api/
site/
temp-clone/

# ================================
# Analysis & Debug Files
# ================================
gradle-plugin-analysis.md
PUBLISHED_PLUGIN_DEBUGGING.md
/benchmark/
.cache/

# ================================
# Spotless
# ================================
spotless/

# ================================
# Claude Code working files
# ================================
.claude/scheduled_tasks.lock
handoff-prompt-*.txt
research-prompts-*.txt

# JVM heap dumps from OOM crashes during local test runs
**/*.hprof
